--- /dev/null
+++ b/iokit/Kernel/arm/PolarisDisplay.h
@@ -0,0 +0,90 @@
+/*
+ * POLARIS: display geometry, shared by PolarisFramebuffer.cpp (what gets copied to
+ * the panel) and hid/PolarisHID.cpp (where a panel touch lands on the presented
+ * display). The two must agree exactly, so the numbers and the mapping live
+ * here instead of in each driver.
+ *
+ * The iOS userland only has status bar and layout data for real iPhone
+ * screens, so the panel is presented as the iPhone X display, 1125x2436
+ * (375x812 points @3x). What the panel actually scans out differs per board:
+ *
+ *   default   1080x2400, 6.67", 395 ppi - 19.5:9, close enough to the
+ *            iPhone X that the centre 1080x2400 of the presentation is
+ *            shown unscaled (polarispanel=0); not the Mi MIX 2S panel.
+ *   polaris  1080x2160, 5.99", 403 ppi - 18:9, so cropping would cut 46
+ *            points off the status bar and the home indicator. The whole
+ *            presentation is scaled by height instead: 998x2160, which is
+ *            62.9x136.1 mm against the iPhone X's 62.4x135.1 mm, with black
+ *            bars on the sides. Boot-arg polarispanel=1 selects this; the
+ *            framebuffer and the touch driver read the same argument, so they
+ *            cannot disagree about the mapping.
+ */
+#ifndef _IOKIT_POLARIS_DISPLAY_H_
+#define _IOKIT_POLARIS_DISPLAY_H_
+
+#include <stdint.h>
+
+#define POLARIS_DISPLAY_LOGICAL_W         1125    /* iPhone X, 375x812 pt @3x */
+#define POLARIS_DISPLAY_LOGICAL_H         2436
+#define POLARIS_DISPLAY_PANEL_W           1080
+/* The 1080x2400 19.5:9 panel; only the native (unscaled) path uses it. */
+#define POLARIS_DISPLAY_ALT_H             2400
+#define POLARIS_DISPLAY_POLARIS_H         2160    /* polaris */
+
+struct polaris_display_plan {
+	int32_t contentW, contentH;     /* panel area the presentation fills */
+	int32_t offX, offY;             /* panel origin of the presentation */
+	int32_t scale;                  /* content is scaled, not cropped */
+};
+
+/*
+ * fit=0 shows the centre panelW x panelH of the logical display, which is what
+ * polaris does (the two aspects are 2.6% apart). fit=1 scales the whole logical
+ * display into the panel.
+ *
+ * The whole logical display only fits by height when it is narrower than the
+ * panel, which is the case here (1125/2436 against 1080/2160); any other pair
+ * falls back to the crop mapping, so no rectangle can land outside the panel.
+ */
+static inline __attribute__((__unused__)) struct polaris_display_plan
+polaris_display_plan_make(int32_t logicalW, int32_t logicalH, int32_t panelW, int32_t panelH,
+    int fit)
+{
+	struct polaris_display_plan p;
+
+	p.scale = 0;
+	p.contentW = panelW;
+	p.contentH = panelH;
+	if (fit && (int64_t)logicalW * panelH < (int64_t)panelW * logicalH) {
+		p.contentW = (int32_t)(((int64_t)logicalW * panelH + logicalH / 2) / logicalH);
+		p.contentH = panelH;
+		p.offX = (panelW - p.contentW) / 2;
+		p.offY = 0;
+		p.scale = 1;
+	} else {
+		p.offX = (logicalW - panelW) / 2;
+		p.offY = (logicalH - panelH) / 2;
+	}
+	return p;
+}
+
+/* Panel pixel -> logical (presented) pixel, rounded and clamped. */
+static inline __attribute__((__unused__)) int32_t
+polaris_display_panel_to_logical(int32_t v, int32_t off, int32_t logical, int32_t content)
+{
+	int64_t l;
+
+	if (content <= 0) {
+		return 0;
+	}
+	l = ((int64_t)(v - off) * logical + content / 2) / content;
+	if (l < 0) {
+		return 0;
+	}
+	if (l > logical - 1) {
+		return logical - 1;
+	}
+	return (int32_t)l;
+}
+
+#endif /* _IOKIT_POLARIS_DISPLAY_H_ */
