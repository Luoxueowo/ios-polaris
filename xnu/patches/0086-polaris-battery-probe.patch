+	{
+		int polaris = 0;
+		(void)PE_parse_boot_argn("polarispanel", &polaris, sizeof(polaris));
+		sp_polaris = polaris != 0;
+	}
+	printf("POLARIS BATTERY: SPMI arb=%#x APIDs=%u, observer reads only%s\n",
+	    arb_version, sp_count, sp_polaris ? " (polaris PMI8998 SID 2)" : "");
 	return 0;
 }
 
