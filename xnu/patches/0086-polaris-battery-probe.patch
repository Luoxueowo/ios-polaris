+/*
+ * polaris: dump PMI8998 fg-gen3 the way the DTB splits it. The offsets inside
+ * each block are the vendor's; three 32-byte windows are enough to map them
+ * (SOC, voltage and current show up as plausible values).
+ */
+void
+polaris_spmi_polaris_probe(void)
+{
+	static const uint16_t blocks[] = {0x4000, 0x4100, 0x4400};
+	if (polaris_spmi_init() != 0) {
+		printf("POLARIS BATTERY: polaris probe skipped, SPMI not ready\n");
+		return;
+	}
+	for (unsigned b = 0; b < sizeof(blocks) / sizeof(blocks[0]); ++b) {
+		char line[3 * 32 + 1];
+		unsigned n = 0;
+		for (unsigned i = 0; i < 32; ++i) {
+			uint8_t v = 0;
+			if (polaris_spmi_read(2, blocks[b] + i, &v) != 0) {
+				n += snprintf(line + n, sizeof(line) - n, " --");
+			} else {
+				n += snprintf(line + n, sizeof(line) - n, " %02x", v);
+			}
+			if (n >= sizeof(line) - 4) {
+				break;
+			}
+		}
+		printf("POLARIS BATTERY: polaris PMI8998 %#x:%s\n", blocks[b], line);
+	}
+}
