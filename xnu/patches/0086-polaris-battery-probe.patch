 {
 	/* Restrict access to the battery blocks; keys retain their own lanes. */
 	unsigned peripheral = addr >> 8;
-	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
-	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
-	    peripheral != 0x13 && peripheral != 0x48)) {
+	bool allowed;
+	if (sp_polaris) {
+		/* PMI8998: fg-batt-soc / fg-batt-info / fg-memif on SID 2, and on
+		 * SID 0 the PM8998 LDO28 block (0x5b00) that feeds the touch avdd. */
+		allowed = (sid == 2 && (peripheral == 0x40 || peripheral == 0x41 ||
+		    peripheral == 0x44)) ||
+		    (sid == 0 && peripheral == 0x5b);
+	} else {
+		allowed = sid == 0 && (peripheral == 0x10 || peripheral == 0x11 ||
+		    peripheral == 0x12 || peripheral == 0x13 || peripheral == 0x48);
+	}
+	/* The touch avdd rail is readable whatever the board flag says; the
+	 * flag only decides which battery blocks are exposed. */
+	if (sid == 0 && peripheral == 0x5b) {
+		allowed = true;
+	}
+	if (!sp_ready || !out || addr > 0xffffu || !allowed) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
